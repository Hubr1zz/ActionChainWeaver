.aq-root {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgb(30, 32, 36);
    color: rgb(216, 220, 226);
    font-size: 12px;
}

.aq-shell {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.aq-navigation {
    flex-grow: 1;
    min-width: 180px;
    max-width: 300px;
    background-color: rgb(24, 26, 30);
    border-right-width: 1px;
    border-right-color: rgb(56, 59, 66);
}

.aq-brand {
    height: 74px;
    flex-shrink: 0;
    padding-left: 14px;
    padding-right: 12px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(49, 52, 58);
}

.aq-brand-icon {
    width: 38px;
    height: 38px;
    margin-right: 11px;
    border-radius: 6px;
    background-color: rgb(45, 126, 193);
    color: white;
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-center;
}

#brand-title {
    color: rgb(233, 236, 241);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

#brand-subtitle {
    margin-top: 2px;
    color: rgb(160, 168, 180);
    font-size: 11px;
}

.aq-menu {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    padding-top: 8px;
    padding-left: 7px;
    padding-right: 7px;
}

.aq-menu-section {
    margin-top: 14px;
    margin-bottom: 5px;
    padding-left: 9px;
    color: rgb(145, 153, 166);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.aq-menu-item {
    min-height: 52px;
    height: auto;
    margin-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.aq-menu-item:hover {
    background-color: rgb(35, 38, 44);
}

.aq-menu-item.is-selected {
    background-color: rgb(39, 55, 70);
    border-left-color: rgb(61, 157, 229);
}

.aq-menu-icon {
    width: 28px;
    color: rgb(133, 177, 214);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.aq-menu-copy {
    flex-grow: 1;
    min-width: 0;
    margin-left: 5px;
}

.aq-menu-title {
    color: rgb(218, 223, 229);
    font-size: 13px;
    -unity-font-style: bold;
}

.aq-menu-subtitle {
    margin-top: 2px;
    color: rgb(158, 166, 178);
    font-size: 11px;
    white-space: normal;
}

.aq-menu-item.is-selected .aq-menu-title {
    color: white;
}

.aq-menu-item.is-selected .aq-menu-subtitle {
    color: rgb(166, 201, 228);
}

.aq-navigation-footer {
    flex-shrink: 0;
    padding: 11px;
    border-top-width: 1px;
    border-top-color: rgb(49, 52, 58);
}

.aq-status-pill {
    height: 21px;
    padding-left: 8px;
    padding-right: 8px;
    align-self: flex-start;
    border-radius: 10px;
    background-color: rgb(48, 51, 58);
    color: rgb(170, 177, 188);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.aq-status-pill.is-playing {
    background-color: rgb(35, 77, 54);
    color: rgb(115, 226, 153);
}

.aq-footer-detail {
    margin-top: 7px;
    color: rgb(155, 163, 175);
    font-size: 11px;
}

.aq-workspace {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgb(31, 33, 38);
}

.aq-page-header {
    min-height: 74px;
    flex-shrink: 0;
    padding-left: 22px;
    padding-right: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(35, 37, 42);
    border-bottom-width: 1px;
    border-bottom-color: rgb(56, 59, 66);
}

.aq-page-titles {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.aq-page-title {
    color: rgb(238, 240, 244);
    font-size: 20px;
    -unity-font-style: bold;
}

.aq-page-subtitle {
    margin-top: 4px;
    color: rgb(161, 169, 181);
    font-size: 12px;
    white-space: normal;
}

.aq-header-badge {
    min-width: 52px;
    height: 22px;
    padding-left: 9px;
    padding-right: 9px;
    margin-left: 12px;
    border-radius: 11px;
    background-color: rgb(42, 68, 88);
    color: rgb(125, 198, 244);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.aq-page-content {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: 12px;
}

.aq-runtime-canvas {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.aq-card {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(36, 38, 43);
    border-width: 1px;
    border-color: rgb(57, 60, 67);
    border-radius: 5px;
}

.aq-type-toolbar {
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    padding-left: 5px;
    padding-right: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 61, 68);
}

.aq-type-search-hint {
    margin-left: 10px;
    margin-right: 8px;
    color: rgb(158, 166, 178);
    font-size: 11px;
}

.aq-type-tabs {
    height: 38px;
    min-height: 38px;
    flex-shrink: 0;
    padding-left: 9px;
    padding-right: 9px;
    flex-direction: row;
    align-items: flex-end;
    background-color: rgb(32, 34, 39);
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 61, 68);
}

.aq-type-tab {
    min-width: 86px;
    height: 31px;
    margin-right: 3px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(166, 173, 184);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-font-style: bold;
    font-size: 12px;
}

.aq-type-tab:hover {
    background-color: rgb(40, 43, 49);
    color: rgb(225, 229, 235);
}

.aq-type-tab.is-selected {
    background-color: rgb(38, 48, 58);
    color: rgb(124, 199, 245);
    border-bottom-color: rgb(61, 157, 229);
}

.aq-type-list {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    border-width: 0;
}

.aq-type-empty {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-height: 0;
    white-space: normal;
    color: rgb(155, 163, 175);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.aq-type-row {
    height: 80px;
    min-height: 80px;
    padding-left: 12px;
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 7px;
    color: rgb(211, 216, 224);
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 51, 57);
}

.aq-type-row-header {
    flex-direction: row;
    align-items: center;
}

.aq-type-row-header #type-display {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: rgb(232, 235, 240);
    font-size: 13px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.aq-type-row-header #type-kind {
    min-width: 72px;
    flex-shrink: 0;
    margin-left: 8px;
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(126, 199, 241);
    font-size: 11px;
    -unity-text-align: middle-right;
}

.aq-type-row #type-full-name {
    margin-top: 3px;
    color: rgb(174, 182, 194);
    font-size: 12px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.aq-type-row #type-category {
    margin-top: 3px;
    color: rgb(145, 154, 166);
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.aq-guide {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    padding-right: 5px;
}

.aq-guide-card {
    margin-bottom: 10px;
    padding: 16px;
    background-color: rgb(37, 40, 45);
    border-width: 1px;
    border-color: rgb(58, 62, 69);
    border-left-width: 3px;
    border-left-color: rgb(55, 145, 211);
    border-radius: 5px;
}

.aq-guide-title {
    margin-bottom: 8px;
    color: rgb(230, 233, 238);
    font-size: 13px;
    -unity-font-style: bold;
}

.aq-guide-body {
    color: rgb(177, 184, 195);
    font-size: 12px;
    white-space: normal;
}

.aq-light {
    background-color: rgb(239, 241, 244);
    color: rgb(42, 47, 55);
}

.aq-light .aq-navigation,
.aq-light .aq-workspace {
    background-color: rgb(247, 248, 250);
    border-right-color: rgb(205, 209, 216);
}

.aq-light .aq-brand,
.aq-light .aq-navigation-footer,
.aq-light .aq-page-header,
.aq-light .aq-type-toolbar,
.aq-light .aq-type-tabs {
    border-color: rgb(211, 215, 222);
    background-color: rgb(235, 238, 242);
}

.aq-light #brand-title,
.aq-light .aq-menu-title,
.aq-light .aq-page-title,
.aq-light .aq-guide-title,
.aq-light .aq-type-row-header #type-display {
    color: rgb(34, 39, 47);
}

.aq-light #brand-subtitle,
.aq-light .aq-page-subtitle,
.aq-light .aq-menu-subtitle,
.aq-light .aq-type-search-hint,
.aq-light .aq-footer-detail,
.aq-light .aq-guide-body,
.aq-light .aq-type-row #type-full-name,
.aq-light .aq-type-row #type-category {
    color: rgb(78, 86, 98);
}

.aq-light .aq-menu-section {
    color: rgb(88, 97, 110);
}

.aq-light .aq-menu-icon {
    color: rgb(24, 91, 140);
}

.aq-light .aq-header-badge {
    background-color: rgb(204, 220, 234);
    color: rgb(20, 89, 139);
}

.aq-light .aq-menu-item:hover {
    background-color: rgb(224, 230, 237);
}

.aq-light .aq-menu-item.is-selected {
    background-color: rgb(211, 226, 239);
}

.aq-light .aq-menu-item.is-selected .aq-menu-title {
    color: rgb(24, 45, 64);
}

.aq-light .aq-menu-item.is-selected .aq-menu-subtitle {
    color: rgb(53, 91, 121);
}

.aq-light .aq-status-pill {
    background-color: rgb(218, 222, 228);
    color: rgb(68, 76, 87);
}

.aq-light .aq-status-pill.is-playing {
    background-color: rgb(205, 233, 216);
    color: rgb(24, 111, 55);
}

.aq-light .aq-card,
.aq-light .aq-guide-card {
    background-color: rgb(250, 251, 252);
    border-color: rgb(207, 212, 219);
}

.aq-light .aq-type-tabs {
    background-color: rgb(230, 234, 239);
}

.aq-light .aq-type-tab {
    color: rgb(74, 82, 94);
}

.aq-light .aq-type-tab:hover {
    background-color: rgb(214, 220, 228);
    color: rgb(36, 43, 52);
}

.aq-light .aq-type-tab.is-selected {
    background-color: rgb(204, 220, 234);
    color: rgb(20, 89, 139);
}

.aq-light .aq-type-row {
    color: rgb(45, 52, 61);
    border-bottom-color: rgb(220, 224, 230);
}

.aq-light .aq-type-row-header #type-kind {
    color: rgb(20, 89, 139);
}

.aq-light .aq-type-empty {
    color: rgb(76, 84, 96);
}
